# Copy to .env and adjust. All variables are prefixed SENTINEL_.

# --- core ---
SENTINEL_DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@localhost:5432/sentinel
# For local dev without Postgres:
# SENTINEL_DATABASE_URL=sqlite+aiosqlite:///./sentinel.db
SENTINEL_JWT_SECRET=please-generate-a-long-random-secret
SENTINEL_SECRET_ENCRYPTION_KEY=please-generate-a-32-byte-random-secret
SENTINEL_ENVIRONMENT=production

# --- execution harness budgets (global ceilings) ---
SENTINEL_MAX_CONCURRENT_ASSESSMENTS=4
SENTINEL_MAX_REQUESTS_PER_ASSESSMENT=5000
SENTINEL_MAX_ASSESSMENT_SECONDS=1800
SENTINEL_DEFAULT_RATE_LIMIT_PER_SEC=20

# --- network boundary ---
# Set false in production so RFC1918/loopback targets are denied unless in a lab.
SENTINEL_ALLOW_PRIVATE_NETWORKS=false

# --- optional LLM brains for the agent pool ---
# When set, every agent's reasoning uses the Anthropic Messages API; otherwise a
# deterministic fallback brain runs (the platform stays fully functional offline).
SENTINEL_ANTHROPIC_API_KEY=
SENTINEL_PLANNER_MODEL=claude-opus-4-8
SENTINEL_ENABLE_LLM_PLANNER=false

# --- tracing (optional; OTLP collector like Jaeger/Tempo) ---
SENTINEL_OTLP_ENDPOINT=
