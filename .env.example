# Copy to .env and adjust. All variables keep the SENTINEL_ prefix (backward compatible).

# --- core ---
SENTINEL_DATABASE_URL=postgresql+asyncpg://sentrik:${SENTRIK_DB_PASSWORD}@localhost:5432/sentrik
# For local dev without Postgres:
# SENTINEL_DATABASE_URL=sqlite+aiosqlite:///./sentrik.db
# Generate with: openssl rand -hex 32   (production refuses short or placeholder values)
SENTINEL_JWT_SECRET=
SENTINEL_SECRET_ENCRYPTION_KEY=
SENTINEL_ENVIRONMENT=production

# --- execution harness budgets (global ceilings) ---
SENTINEL_MAX_CONCURRENT_ASSESSMENTS=4
SENTINEL_MAX_REQUESTS_PER_ASSESSMENT=5000
SENTINEL_MAX_ASSESSMENT_SECONDS=1800
SENTINEL_DEFAULT_RATE_LIMIT_PER_SEC=20
SENTINEL_CRAWL_MAX_PAGES=25
SENTINEL_CRAWL_MAX_DEPTH=3

# --- per-action approval gating (state-changing / invasive plan steps) ---
SENTINEL_STEP_APPROVAL_REQUIRED=true
SENTINEL_STEP_APPROVAL_WAIT_SECONDS=0

# --- network boundary ---
# Set false in production so RFC1918/loopback targets are denied unless in a lab.
SENTINEL_ALLOW_PRIVATE_NETWORKS=false
# Per-run sandbox egress allow-list: none | process | container
SENTINEL_SANDBOX_MODE=none

# --- optional LLM brains for the agent pool ---
# When set, every agent's reasoning uses Anthropic (via LangChain); otherwise the
# deterministic rule-based brain runs (fully functional offline, not model reasoning).
SENTINEL_ANTHROPIC_API_KEY=
SENTINEL_PLANNER_MODEL=claude-opus-4-8
# Per-assessment LLM spend ceilings; 0 = unbounded. Agents degrade to the deterministic
# brain once a ceiling is reached (audit brain_source=budget_exceeded).
SENTINEL_MAX_LLM_TOKENS_PER_ASSESSMENT=0
SENTINEL_MAX_LLM_COST_USD_PER_ASSESSMENT=0
SENTINEL_LLM_COST_PER_1K_TOKENS_USD=0.015
# Deep Agents plan re-ranker (reorder-only; builtin shell/filesystem tools denied)
SENTINEL_USE_DEEPAGENTS_PLANNER=false
# Durable LangGraph workflow engine (SQLite checkpointer; path optional)
SENTINEL_USE_LANGGRAPH=false
SENTINEL_LANGGRAPH_CHECKPOINT_DB=

# --- private inference (OpenAI-compatible: vLLM / Ollama / LM Studio) ---
SENTINEL_LOCAL_LLM_BASE_URL=
SENTINEL_LOCAL_LLM_MODEL=

# --- SSO / OIDC ---
SENTINEL_OIDC_ENABLED=false
SENTINEL_OIDC_ISSUER=
SENTINEL_OIDC_AUDIENCE=
SENTINEL_OIDC_JWKS_URL=

# --- evidence / report object storage: db | local | s3 ---
SENTINEL_STORAGE_BACKEND=db
SENTINEL_STORAGE_LOCAL_DIR=./sentrik_storage
SENTINEL_S3_ENDPOINT_URL=
SENTINEL_S3_BUCKET=
SENTINEL_S3_REGION=us-east-1
SENTINEL_S3_ACCESS_KEY=
SENTINEL_S3_SECRET_KEY=

# --- tracing (optional; OTLP collector like Jaeger/Tempo) ---
SENTINEL_OTLP_ENDPOINT=
